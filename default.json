{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "The shared Renovate preset of zeabur-oss: extend it with \"github>zeabur-oss/.github\". Commits sign off, as the DCO check requires of every commit.",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Taipei",
  "schedule": ["* 0-5 * * 1"],
  "labels": ["dependencies"],
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
