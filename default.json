{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "The shared Renovate preset of zeabur-oss: extend it with \"github>zeabur-oss/.github\". Commits sign off, as the DCO check requires of every commit.",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Taipei",
  "labels": ["dependencies"],
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "schedule": ["* 3-6 * * *"],
  "updateNotScheduled": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 3-6 * * 1"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "The pins of zeabur-oss/.github move in the Update workflow: the shared workflows and actions, @zeabur-oss/release in package.json and the flake input in flake.lock.",
      "matchPackageNames": [
        "zeabur-oss/.github",
        "@zeabur-oss/release",
        "https://github.com/zeabur-oss/.github"
      ],
      "enabled": false
    },
    {
      "description": "K3s moves when its stable channel does, which is what Zeabur's installer installs by default. A release reaches that channel only after K3s has tried it, so there is no extra wait. The test images and the documented release move in one pull request.",
      "matchDatasources": ["custom.k3s-stable", "custom.k3s-stable-image"],
      "groupName": "k3s",
      "minimumReleaseAge": null
    }
  ],
  "customDatasources": {
    "k3s-stable": {
      "defaultRegistryUrlTemplate": "https://update.k3s.io/v1-release/channels",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $$.(data[id = 'stable'].latest), \"changelogUrl\": $join([\"https://github.com/k3s-io/k3s/releases/tag/\", data[id = 'stable'].latest])}], \"sourceUrl\": \"https://github.com/k3s-io/k3s\", \"homepage\": \"https://k3s.io/\"}"
      ]
    },
    "k3s-stable-image": {
      "defaultRegistryUrlTemplate": "https://update.k3s.io/v1-release/channels",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $replace($$.(data[id = 'stable'].latest), '+', '-'), \"changelogUrl\": $join([\"https://github.com/k3s-io/k3s/releases/tag/\", data[id = 'stable'].latest])}], \"sourceUrl\": \"https://github.com/k3s-io/k3s\", \"homepage\": \"https://k3s.io/\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The rancher/k3s image of the cluster tests: scripts, xtask and CONTRIBUTING.md.",
      "managerFilePatterns": [
        "/^CONTRIBUTING\\.md$/",
        "/^scripts/.+\\.sh$/",
        "/^xtask/.+\\.rs$/"
      ],
      "matchStrings": ["rancher/k3s:(?<currentValue>v[0-9.]+-k3s[0-9]+)"],
      "depNameTemplate": "k3s",
      "datasourceTemplate": "custom.k3s-stable-image",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The K3s release the docs install with INSTALL_K3S_VERSION.",
      "managerFilePatterns": ["/^docs/.+\\.mdx?$/", "/^README\\.md$/"],
      "matchStrings": [
        "INSTALL_K3S_VERSION=(?<currentValue>v[0-9.]+\\+k3s[0-9]+)"
      ],
      "depNameTemplate": "k3s",
      "datasourceTemplate": "custom.k3s-stable",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ]
}
