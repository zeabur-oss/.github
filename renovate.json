{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>zeabur-oss/.github"],
  "enabledManagers": ["github-actions", "custom.regex"],
  "customManagers": [
    {
      "description": "Inputs that name a release, marked with a `# renovate: depName=` comment above them.",
      "customType": "regex",
      "managerFilePatterns": ["/^actions/.+/action\\.ya?ml$/"],
      "matchStrings": ["# renovate: depName=(?<depName>\\S+)\\n\\s+version: (?<currentValue>v\\S+)"],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "The hestia pin and its version input move together.",
      "matchPackageNames": ["Mic92/hestia"],
      "groupName": "hestia"
    }
  ]
}
