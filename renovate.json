{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>zeabur-oss/.github"],
  "enabledManagers": ["github-actions", "custom.regex"],
  "customManagers": [
    {
      "description": "Mic92/hestia: the action pin, its version comment and its version input are one dependency, so they always name the same release.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/^actions/.+/action\\.ya?ml$/"],
      "matchStrings": [
        "(?<head>uses: Mic92/hestia@)(?<currentDigest>[0-9a-f]{40}) # v\\S+(?<mid>\\n\\s+with:\\n\\s+version: )(?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "Mic92/hestia",
      "datasourceTemplate": "github-tags",
      "autoReplaceStringTemplate": "{{{head}}}{{{newDigest}}} # {{{newValue}}}{{{mid}}}{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "description": "The custom manager above owns Mic92/hestia.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["Mic92/hestia"],
      "enabled": false
    }
  ]
}
